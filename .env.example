# Copy to .env and fill in. .env is git-ignored.
COLIMA_PROFILE=agents
COLIMA_CPU=6
COLIMA_MEMORY=12
COLIMA_DISK=60

GATEWAY_API_VERSION=v1.5.0
# Set from https://agentgateway.dev/docs/kubernetes/latest/quickstart/install/
AGW_VERSION=
# Optional: pin kagent chart version (blank = latest)
KAGENT_VERSION=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
