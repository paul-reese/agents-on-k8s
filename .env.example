# Copy to .env and fill in. .env is git-ignored.
COLIMA_PROFILE=agents
COLIMA_CPU=6
COLIMA_MEMORY=12
COLIMA_DISK=60
# kagent 1.0 needs Kubernetes >= 1.35 (Pod Certificates)
K8S_VERSION=v1.35.0+k3s1

GATEWAY_API_VERSION=v1.6.3
# agentgateway control plane chart (https://agentgateway.dev/docs/kubernetes/latest/quickstart/install/)
AGW_VERSION=v1.7.0
# Optional: pin the kagent CLI/release, e.g. v1.0.1 (blank = newest release)
KAGENT_VERSION=

ANTHROPIC_API_KEY=
